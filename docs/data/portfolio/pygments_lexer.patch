+
+
+class _FirstChars:
+    """Sound over-approximation of chars a regex can start with.
+
+    ``chars`` is the (possibly excluded) set; ``complement`` flips meaning.
+    """
+
+    __slots__ = ("chars", "complement")
+
+    def __init__(self, chars, complement):
+        self.chars = chars
+        self.complement = complement
+
+    def __contains__(self, ch):
+        if self.complement:
+            return ch not in self.chars
+        return ch in self.chars
+
+
+_ANY = _FirstChars(frozenset(), True)
+
+
+def _seq_first(seq):
+    """First-chars of a parsed sequence -> (chars|None, nullable)."""
+    union, nullable, saw_complement = set(), True, False
+    for op, av in seq:
+        result = _item_first(op, av)
+        if result is None:
+            return None, True
+        chars, item_nullable = result
+        if chars is None:
+            return None, True
+        if chars.complement:
+            saw_complement = True
+        else:
+            union |= chars.chars
+        if not item_nullable:
+            nullable = False
+            break
+    if nullable:
+        # A nullable pattern can match (consuming nothing) at ANY position:
+        # its effective first-char set is universal.
+        return _ANY, True
+    if saw_complement:
+        return _ANY, nullable
+    return _FirstChars(frozenset(union), False), nullable
+
+
+def _item_first(op, av):
+    if op is _sre_parse.LITERAL:
+        return _FirstChars(frozenset((chr(av),)), False), False
+    if op is _sre_parse.NOT_LITERAL:
+        return _FirstChars(frozenset((chr(av),)), True), False
+    if op is _sre_parse.ANY:
+        return _ANY, False
+    if op is _sre_parse.IN:
+        include, exclude, unknown, negate = set(), set(), False, False
+        for sub_op, sub_av in av:
+            if sub_op is _sre_parse.NEGATE:
+                negate = True
+            elif sub_op is _sre_parse.LITERAL:
+                (exclude if negate else include).add(chr(sub_av))
+            elif sub_op is _sre_parse.RANGE:
+                lo, hi = sub_av
+                if hi - lo > 1024:
+                    unknown = True
+                else:
+                    (exclude if negate else include).update(
+                        chr(c) for c in range(lo, hi + 1))
+            else:  # CATEGORY etc.
+                unknown = True
+        if unknown:
+            return None
+        if negate:
+            return _FirstChars(frozenset(exclude), True), False
+        return _FirstChars(frozenset(include), False), False
+    _possessive = tuple(
+        getattr(_sre_parse, name) for name in ("POSSESSIVE_REPEAT", "POSSESSIVE_REPEAT_ONE")
+        if hasattr(_sre_parse, name)
+    )
+    if op in (_sre_parse.SUBPATTERN, _sre_parse.ATOMIC_GROUP) or op in _possessive:
+        # SUBPATTERN/ATOMIC_GROUP/POSSESSIVE_*: (group, flags, seq) or (min, max, seq)
+        return _seq_first(av[-1])
+    if op in (_sre_parse.MAX_REPEAT, _sre_parse.MIN_REPEAT):
+        mn, mx, sub = av
