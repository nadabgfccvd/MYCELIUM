+        parsed = _sre_parse.parse(pattern_str, flags)
+    except Exception:
+        return None
+    chars, _nullable = _seq_first(parsed)
+    return chars
+
+
+_DISPATCH_CACHE = {}
+_PRINTABLE = {chr(c) for c in range(32, 127)} | {"\n", "\t"}
+
+
+def _rules_for(statetokens, text, pos):
+    ch = text[pos]
+    entry = _DISPATCH_CACHE.get(id(statetokens))
+    if entry is None or entry[0] is not statetokens:
+        firsts = []
+        for rexmatch, _action, _new_state in statetokens:
+            pattern = getattr(rexmatch, "__self__", None)
+            src = getattr(pattern, "pattern", None)
+            flags = getattr(pattern, "flags", 0)
+            firsts.append(None if src is None else _regex_first_chars(src, flags))
+        keys = set(_PRINTABLE)
+        for fs in firsts:
+            if fs is not None and not fs.complement:
+                keys |= fs.chars
+        if len(keys) > 2048:
+            table = None
+        else:
+            table = {}
+            for key in keys:
+                table[key] = [
+                    rule for rule, fs in zip(statetokens, firsts)
+                    if fs is None or key in fs
+                ]
+        # Default for chars we did not enumerate (complement sets contain
+        # them): keep every rule whose first-set is None or a complement.
+        if table is None:
+            default = list(statetokens)
+        else:
+            default = [
+                rule for rule, fs in zip(statetokens, firsts)
+                if fs is None or fs.complement
+            ]
+        entry = (statetokens, table, default)
+        _DISPATCH_CACHE[id(statetokens)] = entry
+    table = entry[1]
+    if table is None:
+        return statetokens
+    return table.get(ch, entry[2])
