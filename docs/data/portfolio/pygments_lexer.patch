+        all_chars, any_nullable, unknown = set(), False, False
+        for branch in av[1]:
+            chars, nullable = _seq_first(branch)
+            if chars is None:
+                unknown = True
+                break
+            if chars.complement:
+                return _ANY, True
+            all_chars |= chars.chars
+            any_nullable = any_nullable or nullable
+        if unknown:
+            return None
+        return _FirstChars(frozenset(all_chars), False), any_nullable
+    if op in (_sre_parse.AT, _sre_parse.ASSERT, _sre_parse.ASSERT_NOT):
+        # zero-width: consumes nothing; always passable (over-approximation).
+        return _FirstChars(frozenset(), True), True
+    return None  # GROUPREF and anything else: unknown
+
+
+def _regex_first_chars(pattern_str, flags):
+    import re as _re
+    # IGNORECASE/LOCALE make LITERAL first-chars unreliable ('select' also
+    # matches 'SELECT'); treat as unknown (rule stays in every sublist).
+    if flags & (_re.IGNORECASE | _re.LOCALE):
+        return None
