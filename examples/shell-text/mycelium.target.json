{
  "name": "example-shell-logcount",
  "kind": "shell",
  "prepare_command": "python gen_logs.py",
  "test_command": "sh -c \"test $(python count_500.py) -gt 0\"",
  "benchmark_command": "sh benchmark.sh",
  "metrics_parser": "time",
  "metric_name": "seconds",
  "lower_is_better": true,
  "warmup": 1,
  "repeats": 5,
  "manifest_version": "1.0",
  "variants": [
    {"name": "python-counter", "mode": "env", "env": {"COUNTER": "python"},
     "description": "single python process instead of one grep call"}
  ]
}
