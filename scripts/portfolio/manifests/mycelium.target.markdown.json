{
  "name": "portfolio-p6-markdown-pythonoptimize",
  "kind": "shell",
  "test_command": "python digest_gate_pylib_s2.py markdown",
  "benchmark_command": "python bench_markdown.py",
  "metrics_parser": "json_stdout",
  "metric_name": "seconds",
  "lower_is_better": true,
  "warmup": 1,
  "repeats": 5,
  "timeout_seconds": 180.0,
  "manifest_version": "1.0",
  "variants": [
    {"name": "pythonoptimize-1", "mode": "env", "env": {"PYTHONOPTIMIZE": "1"},
     "description": "P6: skip assert/debug bytecode (-O) for Markdown rendering; honest accept/reject decided by the paired guard"}
  ]
}
