# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Local state produced by the engine
.mycelium_state/
.mycelium_state_*/
.mycelium_self_improve/
.mycelium_benchmarks/
.mycelium_targets/
.mycelium_qd/
.mycelium_environments/
.mycelium_transfer/
.mycelium_semantics/
demo_state/

# Logs and editor files
*.log
.DS_Store
.vscode/
.idea/

# Compiled EC2 example binaries (rebuilt by `make all`)
examples/c/bench_O*

# mkdocs build output
site/

# mutmut runs (Q4/M1; regenerable, never committed)
mutants/
.mutmut-cache/

# Coverage artifacts (local only, never committed)
.coverage
.coverage.*

# UI runtime state (written by scripts/mycelium_ui_server.py; recreated on demand)
.mycelium_ui/

# Build artifacts
# NOTE: dist/ is INTENTIONALLY tracked (see AGENTS.md): the sandbox recycle
# wipes untracked files, and the committed wheel allows fast reinstall.
# .gitignore only affects untracked paths, so listing it here is a no-op that
# documents intent for fresh clones doing local rebuilds.
build/
*.egg-info/
# Auto round reports (generated by scripts/generate_auto_round_report.py)
reports/auto/
